{
  "name": "@adoratorio/medusa",
  "version": "5.0.0",
  "description": "Medusa is a lightweight, SSR-friendly utility for managing multiple IntersectionObservers with flexible event emission, fine-grained control, native once support, and memory-safe cleanup. Ideal for lazy loading, animations, and viewport-based triggers in modern web applications.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "rm -rf ./dist && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "prepublishOnly": "pnpm run check && pnpm run test && pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adoratorio/medusa.git"
  },
  "keywords": [
    "IntersectionObserver",
    "IntersectionObserver manager",
    "intesection",
    "in viewport",
    "lazy load"
  ],
  "author": "Adoratorio Studio <contact@adoratorio.com>",
  "contributors": [
    "Andrea Gottardi <andrea@adoratorio.com>",
    "Daniele Borra <daniele@adoratorio.com>",
    "Andrea Biason <biazo@adoratorio.com>"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Adoratorio/medusa/issues"
  },
  "homepage": "https://github.com/Adoratorio/medusa#readme",
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "happy-dom": "^20.14.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
